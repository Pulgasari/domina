{
  "workspace": [
    "./core",
    "./chain",
    "./packages/methods",
    "./packages/observer",
    "./packages/element",
    "./packages/form",
    "./packages/meta",
    "./packages/fonts",
    "./packages/stylesheet"
  ],
  "tasks": {
    "check": "deno check core/**/*.js",
    "lint": "deno lint core/",
    "fmt": "deno fmt",
    "publish:dry": "deno publish --dry-run"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-unused-vars"]
    }
  }
}
